    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tempo/core": "workspace:*",
    "drizzle-orm": "^0.41.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
