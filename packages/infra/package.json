{
  "name": "@tempo/infra",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./s3": {
      "types": "./src/s3.ts",
      "import": "./src/s3.ts",
      "default": "./src/s3.ts"
    },
    "./qdrant": {
      "types": "./src/qdrant.ts",
      "import": "./src/qdrant.ts",
      "default": "./src/qdrant.ts"
    },
    "./redis": {
      "types": "./src/redis.ts",
      "import": "./src/redis.ts",
      "default": "./src/redis.ts"
    },
    "./env": {
      "types": "./src/env.ts",
      "import": "./src/env.ts",
      "default": "./src/env.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tempo/core": "workspace:*",
    "@aws-sdk/client-s3": "^3.777.0",
    "@qdrant/js-client-rest": "^1.13.0",
    "ioredis": "5.10.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.14.0"
  }
}
