# Engine settings on the Brev instance. brev-deploy.sh copies this to deploy/.env on the
# instance (never committed) and fills TEMPO_ENGINE_TOKEN with a random value when empty.
# The sidecar uses the same token as TEMPO_BACKEND_TOKEN.
TEMPO_ENGINE_TOKEN=
TEMPO_ENGINE_PORT=8900
TEMPO_DATA_DIR=/home/ubuntu/workspace/tempo
TEMPO_ENGINE_LOG_LEVEL=INFO

# Optional overrides (empty = notebook GPU defaults, see engine/tempo_engine/config.py).
# TEMPO_ENGINE_NAME_HINTS=ohnePixel, Jhon, Akita
# TEMPO_ENGINE_WHISPER_MODEL=large-v3
# TEMPO_ENGINE_CAPTION_BUDGET=120
# TEMPO_ENGINE_RAW_RETENTION=delete
