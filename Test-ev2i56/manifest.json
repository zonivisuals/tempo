{
  "id": "Test-ev2i56",
  "name": "tempo",
  "version": "1.0.0",
  "main": "index.js",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.4"
  },
  "manifestVersion": 5,
  "featureFlags": {
    "enableAlerts": true
  },
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "samplePlugin",
      "panelId": "samplePlugin",
      "label": {
        "default": "Tempo"
      },
      "minimumSize": {
        "width": 320,
        "height": 400
      },
      "maximumSize": {
        "width": 800,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 500
      },
      "preferredFloatingSize": {
        "width": 400,
        "height": 600
      },
      "icons": [
        {
          "width": 32,
          "height": 32,
          "path": "icons/icon_D.png",
          "scale": [1, 2],
          "theme": ["dark", "darkest"],
          "species": ["generic"]
        },
        {
          "width": 32,
          "height": 32,
          "path": "icons/icon_N.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"],
          "species": ["generic"]
        }
      ]
    },
    {
      "type": "command",
      "id": "show_alert",
      "label": {
        "default": "Show Alert"
      }
    }
  ],
  "icons": [
    {
      "width": 32,
      "height": 32,
      "path": "icons/icon_D.png",
      "scale": [1, 2],
      "theme": ["dark", "darkest"],
      "species": ["generic"]
    },
    {
      "width": 32,
      "height": 32,
      "path": "icons/icon_N.png",
      "scale": [1, 2],
      "theme": ["lightest", "light"],
      "species": ["generic"]
    }
  ]
}
