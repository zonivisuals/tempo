# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tempo

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=tempo-videos

# Modal (ML workers)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# API
PORT=3001
NODE_ENV=development
