# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tempo

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=https://xyz-abc.us-east-0.aws.cloud.qdrant.io
QDRANT_API_KEY=

# S3
S3_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=tempo-videos

# Modal (ML workers)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# API
NODE_ENV=development
