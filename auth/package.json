{
  "name": "tempo-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Tempo identity service: Better Auth (email+password, Google/GitHub) on Postgres",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "migrate": "node migrate.mjs",
    "check": "node --check server.mjs && node --check auth.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.5",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "pg": "8.13.1"
  }
}
