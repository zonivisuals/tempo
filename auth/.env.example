# Copy to .env (never commit .env — gitignored).
# BETTER_AUTH_SECRET: >=32 high-entropy chars; rotate via overlap if needed.
#   Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-32-chars-minimum-0123456789ab
# Public base URL of THIS service (iss/aud claims + OAuth callbacks).
BETTER_AUTH_URL=http://127.0.0.1:18099
# Postgres (Supabase free: project Settings → Database → connection string,
# pooler port 6548 recommended). Auth tables: npm run migrate (Better Auth
# CLI creates them — never hand-written).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tempo
PG_POOL_MAX=10
# OAuth (optional — omitted providers stay disabled):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
PORT=18099
