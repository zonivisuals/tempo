# Copy to .env (never commit .env — gitignored).
# BETTER_AUTH_API_KEY: >=32 high-entropy chars; rotate via overlap if needed.
#   Generate: openssl rand -base64 32
BETTER_AUTH_API_KEY=change-me-32-chars-minimum-0123456789ab
# Public base URL of THIS service (iss/aud claims + OAuth callbacks).
BETTER_AUTH_URL=http://127.0.0.1:18099
# Postgres (Supabase free: project Settings → Database → connection string).
# Prefer the pooler (port 6543); if your network filters it, use the direct
# host (db.<ref>.supabase.co, port 5432) instead. Auth tables: npm run
# migrate (migrate.mjs via the installed library — never hand-written).
DATABASE_URL=postgresql://postgres:change-me@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
PG_POOL_MAX=10
# OAuth (optional — omitted providers stay disabled):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
PORT=18099
